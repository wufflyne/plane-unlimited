# plane-unlimited configuration — copy to .env and edit.

# Secret used by Django for sessions/crypto. MUST be changed.
# Generate one with:  openssl rand -hex 24
SECRET_KEY=please-change-me-openssl-rand-hex-24

# Password for the internal Postgres and RabbitMQ services (shared).
# Generate one with:  openssl rand -hex 16
DB_PASSWORD=please-change-me-openssl-rand-hex-16

# Host port the web UI is exposed on.
WEB_PORT=8090

# Hostname users reach the instance at (no scheme, no port; use WEB_PORT for the port).
DOMAIN_NAME=localhost

# Which image to run. Default pulls the published release:
#   wufflyne/plane-unlimited:stable
# For a local build (see README "Install path B") use plane-unlimited:local:
#   PLANE_IMAGE=plane-unlimited:local
PLANE_IMAGE=wufflyne/plane-unlimited:stable
